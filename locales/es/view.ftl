error-unknown-format = formato desconocido: { $name }
error-no-input = nada que mostrar (stdin es una terminal)
error-raw-needs-json = --raw solo vale para json, pero --as pide { $kind }
error-no-viewer = ningún visor disponible para { $kind }{ $hint }
viewer-install-hint = { "" } (instala { $program }: { $hint })
note-install-hint = # { $program } no encontrado: { $hint }
note-image = # imagen: { $protocol }
note-invalid-json = # json inválido: se muestra tal cual
note-invalid-svg = # svg inválido: se muestra como texto
error-image-decode = no se pudo decodificar la imagen (soportados: png, jpeg, gif, webp)
error-svg-invalid = SVG inválido
error-svg-too-large = SVG demasiado grande
error-html-convert = no se pudo convertir el HTML
error-input-invalid = la entrada no es { $format } válido
error-convert-failed = no se pudo convertir { $from } a { $to }
error-csv-invalid = csv inválido
table-truncated = … { $shown } filas mostradas, { $omitted } omitidas (límite de { $max })
error-fetch-timeout = tiempo agotado
error-fetch-too-large = respuesta mayor que { $mib } MiB
error-pager-empty = pager vacío
error-pager-run = no se pudo ejecutar el pager `{ $program }`
error-pager-no-stdin = pager sin stdin
error-not-utf8 = la entrada no es UTF-8
error-image-no-pager = la imagen se escribe directo en la terminal, sin pager
error-not-direct = { $kind } no escribe directo en la terminal
error-read-file = no se pudo leer { $path }
error-run-program = no se pudo ejecutar `{ $program }`
error-program-status = `{ $program }` terminó con { $status }
error-stdin-read = no se pudo leer el stdin
error-create-file = no se pudo crear { $path }
error-write-file = no se pudo escribir { $path }
help-about = Muestra un archivo, URL o stdin con el visor adecuado
help-target = Archivo, directorio o URL. Si falta o es `-`, lee el stdin.
help-verbose = Imprime el encabezado (comando equivalente, notas y regla).
help-dry-run = Solo imprime el comando que se ejecutaría.
help-as = Fuerza el formato (md, json, yaml, code, dir, binary...).
help-raw = Muestra el json tal cual, sin reformatear.
help-no-pager = Escribe directo en stdout, sin pager.
