error-unknown-format = unknown format: { $name }
error-no-input = nothing to show (stdin is a terminal)
error-raw-needs-json = --raw only applies to json, but --as asks for { $kind }
error-no-viewer = no viewer available for { $kind }{ $hint }
viewer-install-hint = { "" } (install { $program }: { $hint })
note-install-hint = # { $program } not found: { $hint }
note-image = # image: { $protocol }
note-invalid-json = # invalid json: shown as is
note-invalid-svg = # invalid svg: shown as text
error-image-decode = could not decode the image (supported: png, jpeg, gif, webp)
error-svg-invalid = invalid SVG
error-svg-too-large = SVG too large
error-html-convert = could not convert the HTML
error-input-invalid = input is not valid { $format }
error-convert-failed = could not convert { $from } to { $to }
error-csv-invalid = invalid csv
table-truncated = … { $shown } rows shown, { $omitted } omitted (limit of { $max })
error-fetch-timeout = timed out
error-fetch-too-large = response larger than { $mib } MiB
error-pager-empty = empty pager
error-pager-run = could not run the pager `{ $program }`
error-pager-no-stdin = pager without stdin
error-not-utf8 = input is not UTF-8
error-image-no-pager = images are written straight to the terminal, without a pager
error-not-direct = { $kind } does not write straight to the terminal
error-read-file = could not read { $path }
error-run-program = could not run `{ $program }`
error-program-status = `{ $program }` exited with { $status }
error-stdin-read = could not read stdin
error-create-file = could not create { $path }
error-write-file = could not write { $path }
help-about = Show a file, URL or stdin with the right viewer
help-target = File, directory or URL. Missing or `-` reads stdin.
help-verbose = Print the header (equivalent command, notes and ruler).
help-dry-run = Only print the command that would run.
help-as = Force the format (md, json, yaml, code, dir, binary...).
help-raw = Show the json as is, without reformatting.
help-no-pager = Write straight to stdout, without a pager.
