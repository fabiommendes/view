error-unknown-format = formato desconhecido: { $name }
error-no-input = nada para mostrar (stdin é um terminal)
error-raw-needs-json = --raw só vale para json, mas --as pede { $kind }
error-no-viewer = nenhum visualizador disponível para { $kind }{ $hint }
viewer-install-hint = { "" } (instale { $program }: { $hint })
note-install-hint = # { $program } não encontrado: { $hint }
note-image = # imagem: { $protocol }
note-invalid-json = # json inválido: mostrado como está
note-invalid-svg = # svg inválido: mostrado como texto
error-image-decode = não foi possível decodificar a imagem (suportados: png, jpeg, gif, webp)
error-svg-invalid = SVG inválido
error-svg-too-large = SVG grande demais
error-html-convert = não foi possível converter o HTML
error-input-invalid = entrada não é { $format } válido
error-convert-failed = não foi possível converter { $from } para { $to }
error-csv-invalid = csv inválido
table-truncated = … { $shown } linhas mostradas, { $omitted } omitidas (limite de { $max })
error-fetch-timeout = tempo esgotado
error-fetch-too-large = resposta maior que { $mib } MiB
error-pager-empty = pager vazio
error-pager-run = não foi possível executar o pager `{ $program }`
error-pager-no-stdin = pager sem stdin
error-not-utf8 = entrada não é UTF-8
error-image-no-pager = imagem escreve direto no terminal, sem pager
error-not-direct = { $kind } não escreve direto no terminal
error-read-file = não foi possível ler { $path }
error-run-program = não foi possível executar `{ $program }`
error-program-status = `{ $program }` terminou com { $status }
error-stdin-read = não foi possível ler o stdin
error-create-file = não foi possível criar { $path }
error-write-file = não foi possível escrever { $path }
help-about = Mostra um arquivo, URL ou stdin com o visualizador certo
help-target = Arquivo, diretório ou URL. Ausente ou `-` lê o stdin.
help-verbose = Imprime o cabeçalho (comando equivalente, notas e régua).
help-dry-run = Só imprime o comando que rodaria.
help-as = Força o formato (md, json, yaml, code, dir, binary...).
help-raw = Mostra o json como está, sem reformatar.
help-no-pager = Escreve direto no stdout, sem pager.
